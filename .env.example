# Copy to .env (git-ignored). EXPO_PUBLIC_* values are bundled into the app — never put secrets here.
# Without these the app runs in guest/local-only mode.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Google Cloud OAuth client IDs (see README "Auth providers")
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=1234-abc.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=1234-def.apps.googleusercontent.com
# Reversed iOS client ID, used at build time by the Google Sign-In config plugin
GOOGLE_IOS_URL_SCHEME=com.googleusercontent.apps.1234-def
